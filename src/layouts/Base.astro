---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import { SOCIAL, SITE_URL } from '../config';

interface Props {
  title: string;
  description?: string;
  /** Extra JSON-LD node, rendered in the head beside the site-wide graph.
      Detail pages pass Movie/TVSeries here; nothing else needs one. */
  schema?: Record<string, unknown>;
}

// Site-wide default. No page overrides it, so this single string is what
// every link preview and search result shows — it was "Discover Anime",
// which said nothing. Matches the About page's own subtitle so the two
// can't drift apart.
const { title, description = 'Independent Anime Subtitles, Burmese', schema } = Astro.props;

// Trailing slash stripped so /about/ and /about both match.
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

// Absolute forms. og:image was relative (`/og-image.jpg`), and every
// scraper that matters — Facebook, X, LinkedIn, Discord — requires an
// absolute URL, so the image we spent a commit on was silently not
// rendering in previews. og:url and twitter:image were missing outright,
// which is why summary_large_image had nothing to draw.
const canonical = `${SITE_URL}${path}`;
const ogImage = `${SITE_URL}/og-image.jpg`;
// Real dimensions of public/og-image.jpg (2x the 1200x630 standard, same
// aspect). Declared so scrapers reserve the right box instead of guessing.
const OG_W = 2400;
const OG_H = 1260;

// JSON-LD. is:inline keeps Astro from hoisting it into a module — this is
// data for crawlers, not a script for the page.
const siteSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${SITE_URL}/#website`,
      url: `${SITE_URL}/`,
      name: 'aniXsubs',
      description,
      inLanguage: 'en',
    },
    {
      '@type': 'Organization',
      '@id': `${SITE_URL}/#organization`,
      name: 'aniXsubs',
      url: `${SITE_URL}/`,
      logo: `${SITE_URL}/apple-touch-icon.png`,
      // Only real profiles — same two that render as footer icons.
      sameAs: [SOCIAL.telegram, SOCIAL.facebook].filter(Boolean),
    },
  ],
};

// Movies and Series are not pages — they are ?type= filters on the catalog.
// They look identical to the rest of the menu, so the inline script below is
// what marks them current; the server cannot know a query string at build time.
const navItems = [
  { href: '/', label: 'Home' },
  { href: '/?type=Movie', label: 'Movies', type: 'Movie' },
  { href: '/?type=Series', label: 'Series', type: 'Series' },
  { href: '/about', label: 'About Us' },
  { href: '/guide', label: 'Guide' },
  { href: '/terms', label: 'Terms & Policies' },
];

const socials = [
  SOCIAL.telegram && {
    href: SOCIAL.telegram,
    label: 'Telegram',
    // Telegram's paper-plane mark.
    path: 'M9.78 18.65l.28-4.23 7.68-6.92c.34-.31-.07-.46-.52-.19L7.74 13.3 3.64 12c-.88-.25-.89-.86.2-1.3l15.97-6.16c.73-.33 1.43.18 1.15 1.3l-2.72 12.81c-.19.91-.74 1.13-1.5.71L12.6 16.3l-1.99 1.93c-.23.23-.42.42-.83.42z',
  },
  SOCIAL.facebook && {
    href: SOCIAL.facebook,
    label: 'Facebook',
    // Facebook's "f" in a circle.
    path: 'M22 12c0-5.52-4.48-10-10-10S2 6.48 2 12c0 4.99 3.66 9.13 8.44 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.78-3.89 1.09 0 2.23.2 2.23.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.99C18.34 21.13 22 16.99 22 12z',
  },
].filter(Boolean) as { href: string; label: string; path: string }[];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <!-- /about and /about/ both answer 200 with no redirect, so without this
         the same page is two URLs and Google has to guess which is real. -->
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#12131f" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="aniXsubs" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(OG_W)} />
    <meta property="og:image:height" content={String(OG_H)} />
    <meta property="og:image:alt" content={description} />
    <!-- twitter:card=summary_large_image is invalid without twitter:image —
         it was set and the image was not, so the card had no picture. -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(siteSchema)} />
    {
      schema && (
        <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
      )
    }
    <Analytics />
    <SpeedInsights />
  </head>
  <body>
    <header class="site-header">
      <!-- Hamburger first, ahead of the logo, and visible at EVERY width —
           it is the only menu now, on desktop as well as mobile. Placing it
           before .brand shifts the logo ~46px right of the shared left edge,
           so from here on the hamburger, not the wordmark, sits on it. -->
      <button type="button" class="nav-toggle" aria-label="Menu" aria-expanded="false" aria-controls="nav-drawer">
        <svg class="nav-icon-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <line x1="4" y1="7" x2="20" y2="7" />
          <line x1="4" y1="12" x2="20" y2="12" />
          <line x1="4" y1="17" x2="20" y2="17" />
        </svg>
        <svg class="nav-icon-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <line x1="6" y1="6" x2="18" y2="18" />
          <line x1="18" y1="6" x2="6" y2="18" />
        </svg>
      </button>

      <a class="brand" href="/">
        <span class="brand-text">ani<img class="brand-x-img" src="/favicon-32.png" alt="X" />subs</span>
      </a>

      <!-- .header-search's margin-left:auto parks the search and filter at the
           far right regardless of what sits to the left of it. -->
      <form class="header-search" action="/" method="get" role="search">
        <svg class="search-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <circle cx="8.5" cy="8.5" r="6" stroke="currentColor" stroke-width="1.6" />
          <path d="M13.3 13.3 18 18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        </svg>
        <input
          type="search"
          name="q"
          class="header-search-input"
          placeholder="Search titles…"
          aria-label="Search titles"
        />
        <button type="button" class="header-search-toggle" aria-label="Open search" aria-expanded="false">
          <svg class="icon-search" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <circle cx="8.5" cy="8.5" r="6" stroke="currentColor" stroke-width="1.6" />
            <path d="M13.3 13.3 18 18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
          </svg>
          <svg class="icon-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <line x1="6" y1="6" x2="18" y2="18"></line>
            <line x1="18" y1="6" x2="6" y2="18"></line>
          </svg>
        </button>
      </form>

      <button type="button" id="filter-toggle" class="filter-toggle-btn header-filter-btn" aria-expanded="false" aria-controls="filter-panel" aria-label="Filters" hidden>
        <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M2 4h16l-6.5 7.5V17l-3 1.5v-7L2 4Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
        </svg>
      </button>
    </header>

    <!-- Deliberately OUTSIDE .site-header. That header is sticky with a
         backdrop-filter, and a filtered element becomes the containing block
         for absolutely positioned descendants — nesting the drawer would pin
         it to the header instead of the viewport. -->
    <div class="nav-drawer" id="nav-drawer" hidden>
      <nav class="nav-drawer-list" aria-label="Primary">
        {navItems.map((item) => (
          <a
            href={item.href}
            class="nav-drawer-link"
            data-nav-type={item.type}
            aria-current={item.type ? undefined : path === item.href ? 'page' : undefined}
          >{item.label}</a>
        ))}
      </nav>
    </div>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-content">
        <!-- Row 1: brand mark beside the social icons. The mark reuses .brand
             and .brand-text outright, so the footer logo is literally the
             header's and the two can never drift apart.

             The About / Guide / Terms links that used to live here moved into
             the header nav, which is a hamburger below 1280 — so the drawer
             is what keeps those pages reachable on a phone. -->
        <div class="footer-top">
          <a href="/" class="brand footer-brand">
            <span class="brand-text">ani<img class="brand-x-img" src="/favicon-32.png" alt="X" />subs</span>
          </a>

          {socials.length > 0 && (
            <nav class="footer-social" aria-label="Social">
              {socials.map((s) => (
                <a
                  href={s.href}
                  class="footer-social-link"
                  aria-label={s.label}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d={s.path} />
                  </svg>
                </a>
              ))}
            </nav>
          )}
        </div>

        <!-- Plain line, no label and no box. "Disclaimer:" in front of it was
             redundant — the sentence is self-evidently one — and the box it
             sat in either shouted (dashed card) or vanished (bare line).
             Keeping the words and dropping the costume. Body font rather than
             mono: it's a sentence to read, not chrome to scan. -->
        <p class="footer-disclaimer">
          aniXsubs does not store any files on its server. All contents are provided by non-affiliated third parties.
        </p>

        <div class="footer-bottom">
          <span class="copyright">&copy; {new Date().getFullYear()} aniXsubs. All rights reserved.</span>
          <!-- Was an inline style on a span inside .copyright. -->
          <span class="footer-version">v1.0.0</span>
        </div>
      </div>
    </footer>

    <button id="scroll-to-top" class="scroll-to-top" aria-label="Back to top">
      <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="18 15 12 9 6 15"></polyline>
      </svg>
    </button>

    <script>
      const scrollTopBtn = document.getElementById('scroll-to-top');

      window.addEventListener('scroll', () => {
        if (window.scrollY > 300) {
          scrollTopBtn.classList.add('show');
        } else {
          scrollTopBtn.classList.remove('show');
        }
      });

      // prefers-reduced-motion: the 'smooth' option ignores it, so ask first.
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

      scrollTopBtn.addEventListener('click', () => {
        window.scrollTo({
          top: 0,
          behavior: reducedMotion.matches ? 'auto' : 'smooth',
        });
      });

      // Mobile header search: icon-only until tapped.
      const headerSearchForm = document.querySelector('.header-search');
      const headerSearchToggle = document.querySelector('.header-search-toggle');
      const headerSearchInput = document.querySelector('.header-search-input');

      if (headerSearchForm && headerSearchToggle && headerSearchInput) {
        headerSearchToggle.addEventListener('click', () => {
          const open = headerSearchForm.classList.toggle('open');
          headerSearchToggle.setAttribute('aria-expanded', String(open));
          headerSearchToggle.setAttribute('aria-label', open ? 'Close search' : 'Open search');
          if (open) {
            headerSearchInput.focus();
          } else {
            headerSearchInput.blur();
          }
        });

        headerSearchInput.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') {
            headerSearchForm.classList.remove('open');
            headerSearchToggle.setAttribute('aria-expanded', 'false');
            headerSearchToggle.setAttribute('aria-label', 'Open search');
            headerSearchInput.blur();
          }
        });
      }

      // ---- Mobile nav drawer -------------------------------------------------
      const navToggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
      const navDrawer = document.getElementById('nav-drawer');
      const siteHeader = document.querySelector('.site-header');

      // The drawer is fixed and lives OUTSIDE the header (see markup note), so
      // `top` is measured, not assumed — the header's height changes when the
      // search box expands on small screens. Driven by a ResizeObserver rather
      // than a scroll handler: the header is sticky, so its box doesn't move
      // once stuck, and observing avoids forcing layout on every scroll frame.
      const syncDrawerTop = () => {
        if (navDrawer && siteHeader) navDrawer.style.top = `${siteHeader.getBoundingClientRect().bottom}px`;
      };

      if (siteHeader) new ResizeObserver(syncDrawerTop).observe(siteHeader);
      syncDrawerTop();

      const setDrawer = (open: boolean) => {
        if (!navDrawer || !navToggle) return;
        if (open) syncDrawerTop();
        navDrawer.hidden = !open;
        navToggle.setAttribute('aria-expanded', String(open));
      };

      navToggle?.addEventListener('click', () => {
        setDrawer(navDrawer?.hidden ?? true);
      });

      // Escape closes and hands focus back to the button that opened it.
      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape' || navDrawer?.hidden !== false) return;
        setDrawer(false);
        navToggle?.focus();
      });

      // Clicking anywhere that isn't the drawer or the toggle closes it.
      document.addEventListener('click', (e) => {
        if (navDrawer?.hidden !== false) return;
        const t = e.target as Node;
        if (navDrawer.contains(t) || navToggle?.contains(t)) return;
        setDrawer(false);
      });

      // ---- Nav active state for Movies / Series ------------------------------
      // These are ?type= links, not paths, so the server can't mark them current
      // at build time — this runs client-side instead.
      const syncTypeNav = () => {
        const type = new URLSearchParams(window.location.search).get('type');
        const isTypeNav = type === 'Movie' || type === 'Series';

        document.querySelectorAll<HTMLElement>('[data-nav-type]').forEach((el) => {
          if (isTypeNav && el.dataset.navType === type) {
            el.setAttribute('aria-current', 'true');
          } else {
            el.removeAttribute('aria-current');
          }
        });

        // Home is "/" too, so it would otherwise stay lit while a filter is on.
        if (isTypeNav) {
          document
            .querySelectorAll<HTMLAnchorElement>('.site-nav a[href="/"], .nav-drawer a[href="/"]')
            .forEach((el) => el.removeAttribute('aria-current'));
        }
      };

      syncTypeNav();
      // The catalog rewrites the URL with history.replaceState, which — unlike
      // pushState — emits no popstate. Rather than reach into that script or
      // poll, patch the History methods once to announce the change. Self-
      // contained here, and correct no matter which page mutates the URL.
      for (const method of ['pushState', 'replaceState'] as const) {
        const original = history[method].bind(history);
        history[method] = (...args: Parameters<History['replaceState']>) => {
          original(...args);
          syncTypeNav();
        };
      }
      window.addEventListener('popstate', syncTypeNav);
    </script>
  </body>
</html>
