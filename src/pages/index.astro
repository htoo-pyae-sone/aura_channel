---
import Base from '../layouts/Base.astro';
import { ANNOUNCEMENT } from '../config';
import { cardHTML } from '../lib/catalog';
import { loadCatalog } from '../lib/catalog-server';

// The announcement also expires in the browser (see syncAnnounce), so it
// disappears on schedule even if nothing is rebuilt. Checking it here too
// means a build taken after the date leaves it out of the HTML entirely.
const announce =
  ANNOUNCEMENT && ANNOUNCEMENT.until
    ? new Date(`${ANNOUNCEMENT.until}T23:59:59`) >= new Date()
      ? ANNOUNCEMENT
      : null
    : ANNOUNCEMENT;

// Every title as a plain card item in grid order (status group, then A-Z).
// The SAME list feeds the server-rendered cards below and
// /catalog-index.json — the lazily-fetched index the browser filters
// against — so the two can't disagree. zz-sample-* fixtures are dev-only;
// loadCatalog drops them from production builds.
const entries = await loadCatalog();

const uniqueGenres = [...new Set(entries.flatMap((e) => e.genres))].sort();
const uniqueYears = [
  ...new Set(entries.map((e) => e.year).filter((y): y is number => typeof y === 'number')),
].sort((a, b) => b - a);

// How many cards ship IN the HTML. 50 covers every page-size option
// (10/20/50), so a first visit renders instantly with no fetch — and the
// page's payload stays flat as the catalog grows, because only this many
// cards ever ship inline. Everything past the first page (and all
// filtering/search) uses /catalog-index.json, fetched on demand by the
// script below.
const SERVER_RENDER_MAX = 50;
const initialCards = entries.slice(0, SERVER_RENDER_MAX).map(cardHTML).join('');
---

<Base title="aniXsubs">
  <h1 class="sr-only">aniXsubs – Anime Catalog</h1>

  {announce && (
    <div class="announce" id="announce" data-until={announce.until} data-text={announce.text}>
      <svg class="announce-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor"
        stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m3 11 18-5v12L3 14v-3z" />
        <path d="M11.6 16.8a3 3 0 1 1-5.8-1.6" />
      </svg>
      <!-- syncAnnounceScroll() fills this with however many copies it takes to
           overrun the strip at any width, then slides the track left by
           exactly one copy — so the loop has no seam and no gap. Copies after
           the first are hidden from screen readers. The track runs ONE pass
           and parks (forwards), so the message is delivered once and then
           just sits there readable. -->
      <div class="announce-viewport">
        <div class="announce-track">
          <span class="announce-item">{announce.text}</span>
        </div>
      </div>
      <!-- Clickable from the first frame at low opacity — nobody should be
           trapped waiting out a ~20s pass to close a notice. Brightens once
           the pass completes. Dismissal is remembered per MESSAGE (see the
           inline script below), so a new announcement shows again for
           everyone who dismissed the old one. -->
      <button class="announce-x" id="announce-x" type="button" aria-label="Dismiss announcement">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
          stroke-linecap="round" aria-hidden="true">
          <path d="M18 6 6 18" />
          <path d="m6 6 12 12" />
        </svg>
      </button>
      <span class="announce-progress" aria-hidden="true"></span>
    </div>
  )}

  {/* A visitor arriving from a genre or year tag on a detail page lands with
      filters already active, and the main script hides the bar for those — but
      that script runs after first paint, so the welcome message appeared for a
      beat and then vanished. This runs during parse, before anything is
      painted, so the bar is never shown for a filtered landing at all.

      It can't live in the frontmatter: this is a static build, so the HTML is
      written once with no query string and Astro.url.searchParams is empty at
      build time. The URL only exists in the browser.

      The rules mirror syncAnnounce() exactly — dismissed, expired, or any
      real constraint — so the two can't disagree and cause a second flash when
      the main script takes over. `page` is not a constraint (see
      activeConstraints), so ?page=2 still shows the bar.

      DISMISSAL IS KEYED TO THE MESSAGE, not to a yes/no flag. The stored
      value is a hash of the text itself, so a visitor who closes the welcome
      never sees it again — but the moment new copy is written in config.ts
      the hash no longer matches and the announcement shows for everyone
      again. No expiry date to remember, and no way to accidentally mute
      future announcements. */}
  <script is:inline>
    (function () {
      var bar = document.getElementById('announce');
      if (!bar) return;

      // djb2: tiny, dependency-free, and stable across builds — enough to
      // identify a message, not a security primitive.
      function announceHash(s) {
        var h = 5381;
        for (var i = 0; i < s.length; i += 1) h = ((h << 5) + h + s.charCodeAt(i)) | 0;
        return (h >>> 0).toString(36);
      }
      window.announceHash = announceHash;

      var dismissed = false;
      try {
        dismissed =
          localStorage.getItem('aura-announce-dismissed') === announceHash(bar.dataset.text || '');
      } catch (e) {
        /* storage blocked (private mode / cookies off) — just show it */
      }
      // Flag it on the element as well as hiding it: syncAnnounce() rewrites
      // `hidden` on every load and filter change, so it has to be able to see
      // the dismissal or it would immediately put the bar back.
      if (dismissed) bar.dataset.dismissed = '1';

      var until = bar.dataset.until;
      var expired = until ? new Date(until + 'T23:59:59') < new Date() : false;
      var params = new URLSearchParams(location.search);
      var filtered =
        (params.get('q') || '').trim() !== '' ||
        ['type', 'status', 'genre', 'year'].some(function (key) {
          var v = params.get(key);
          return v !== null && v !== '' && v !== 'All';
        });

      if (dismissed || expired || filtered) bar.hidden = true;
    })();
  </script>

  <div class="filter-panel" id="filter-panel" hidden>
    <div class="select-row">
      <!-- Each field holds two states and swaps between them:
             unset  -> a picker reading  Type ⌄
             chosen -> a tag reading      Movie ×
           The <select> is invisible and stretched over the whole pill, so the
           field draws the display itself (label + chevron) while the menu still
           lists real option text — "All / Movie / Series", not a blank row.
           Clicking anywhere on the pill opens it.
           Page is the exception — it's a setting, not a filter, so it never
           becomes a tag; its label carries the value instead (Page/10). -->
      <!-- "All" is hidden, not removed: the script still needs it as the
           value for an unset field, but it never renders in the menu. You
           don't pick "All" to clear a filter — you click × on its tag. -->
      <div class="fp-field" data-fp="type">
        <span class="fp-label" aria-hidden="true">Type</span>
        <select id="filter-type" class="filter-select" aria-label="Filter by type">
          <option value="All" hidden>All</option>
          <option value="Movie">Movie</option>
          <option value="Series">Series</option>
        </select>
        <button type="button" class="fp-tag" data-fp-drop="type" hidden>
          <span class="fp-tag-text"></span><span class="af-x" aria-hidden="true">&times;</span>
        </button>
      </div>

      <div class="fp-field" data-fp="status">
        <span class="fp-label" aria-hidden="true">Status</span>
        <select id="filter-status" class="filter-select" aria-label="Filter by status">
          <option value="All" hidden>All</option>
          <option value="Ongoing">Ongoing</option>
          <option value="Completed">Completed</option>
          <option value="Upcoming">Upcoming</option>
        </select>
        <button type="button" class="fp-tag" data-fp-drop="status" hidden>
          <span class="fp-tag-text"></span><span class="af-x" aria-hidden="true">&times;</span>
        </button>
      </div>

      <div class="fp-field" data-fp="genre">
        <span class="fp-label" aria-hidden="true">Genre</span>
        <select id="filter-genre" class="filter-select" aria-label="Filter by genre">
          <option value="All" hidden>All</option>
          {uniqueGenres.map((g) => <option value={g}>{g}</option>)}
        </select>
        <button type="button" class="fp-tag" data-fp-drop="genre" hidden>
          <span class="fp-tag-text"></span><span class="af-x" aria-hidden="true">&times;</span>
        </button>
      </div>

      <div class="fp-field" data-fp="year">
        <span class="fp-label" aria-hidden="true">Year</span>
        <select id="filter-year" class="filter-select" aria-label="Filter by year">
          <option value="All" hidden>All</option>
          {uniqueYears.map((y) => <option value={y}>{y}</option>)}
        </select>
        <button type="button" class="fp-tag" data-fp-drop="year" hidden>
          <span class="fp-tag-text"></span><span class="af-x" aria-hidden="true">&times;</span>
        </button>
      </div>

      <!-- Page: label reads "Page/10" and follows the select. -->
      <div class="fp-field fp-field--pref">
        <span class="fp-label fp-label--val" aria-hidden="true">Page/10</span>
        <select id="page-size" class="filter-select" aria-label="Cards per page">
          <option value="10">10</option>
          <option value="20">20</option>
          <option value="50">50</option>
        </select>
      </div>
    </div>
  </div>

  <div class="active-filters" id="active-filters" hidden></div>

  {/* Server-rendered first page of cards: the page paints (and works, links
      and all) before any script runs, and the payload stays bounded — only
      SERVER_RENDER_MAX cards ever ship, however many titles exist. The
      script re-renders from the lazily-fetched index once you filter, page,
      or arrive deep-linked. data-total tells it whether the catalog even
      needs paging. */}
  <div
    class="catalog-grid"
    id="catalog-grid"
    tabindex="-1"
    data-total={entries.length}
    set:html={initialCards}
  />
  <div class="empty-state" id="empty-state" tabindex="-1" hidden></div>

  <div class="ep-pager ep-pager-bottom catalog-pager" id="cat-pager" hidden>
    <div class="ep-pager-controls" role="navigation" aria-label="Catalog pages">
      <button type="button" id="cat-first" class="ep-page-btn" aria-label="First page">&laquo;</button>
      <button type="button" id="cat-prev" class="ep-page-btn" aria-label="Previous page">&lt;</button>
      <span class="cat-numbers" id="cat-numbers"></span>
      <button type="button" id="cat-next" class="ep-page-btn" aria-label="Next page">&gt;</button>
      <button type="button" id="cat-last" class="ep-page-btn" aria-label="Last page">&raquo;</button>
    </div>
  </div>

  <script>
    import { cardHTML, escapeHTML, type CatalogItem } from '../lib/catalog';

    // The full catalog index is NOT inline in the page — the HTML carries only
    // the first cards (SERVER_RENDER_MAX in the frontmatter), and the rest is
    // fetched lazily: for a deep-linked filter or ?page=, for paging past the
    // rendered cards, or on the first search/filter/page-size interaction. A
    // small catalog that's never filtered never downloads it at all.
    let entries: CatalogItem[] = [];
    let entriesLoaded = false;
    let entriesFetch: Promise<void> | null = null;
    function ensureEntries(): Promise<void> {
      if (entriesLoaded) return Promise.resolve();
      if (!entriesFetch) {
        entriesFetch = fetch('/catalog-index.json')
          .then((res) => {
            if (!res.ok) throw new Error(`catalog-index.json: HTTP ${res.status}`);
            return res.json();
          })
          .then((data: CatalogItem[]) => {
            entries = data;
            entriesLoaded = true;
          })
          .catch((err) => {
            entriesFetch = null; // let the next action retry
            console.error(err);
          });
      }
      return entriesFetch;
    }
    const grid = document.getElementById('catalog-grid');
    const header = document.querySelector('.site-header');
    const emptyState = document.getElementById('empty-state');
    const activeFilters = document.getElementById('active-filters');
    const filterToggle = document.getElementById('filter-toggle');
    const filterPanel = document.getElementById('filter-panel');
    const announceBar = document.getElementById('announce');
    const pager = document.getElementById('cat-pager');
    const firstBtn = document.getElementById('cat-first');
    const prevBtn = document.getElementById('cat-prev');
    const nextBtn = document.getElementById('cat-next');
    const lastBtn = document.getElementById('cat-last');
    const numbers = document.getElementById('cat-numbers');

    // The header search IS the catalog search (single box, Enter to apply).
    const searchInput = document.querySelector('.header-search-input');
    const typeSelect = document.getElementById('filter-type');
    const statusSelect = document.getElementById('filter-status');
    const genreSelect = document.getElementById('filter-genre');
    const yearSelect = document.getElementById('filter-year');
    const pageSizeSelect = document.getElementById('page-size');

    // Cards per page: saved choice wins, else 20 on desktop / 10 on phones.
    function readStoredSize() {
      try {
        const v = parseInt(localStorage.getItem('aura-page-size') || '', 10);
        return [10, 20, 50].includes(v) ? v : 0;
      } catch (e) {
        return 0;
      }
    }
    // Page size: saved choice wins, else 20 on desktop / 10 on phones.
    let pageSize = readStoredSize();
    if (!pageSize) {
      pageSize = window.matchMedia('(min-width: 1024px)').matches ? 20 : 10;
    }

    // Page's label is its value — "Page/10" — since Page never becomes a tag.
    const pageLabel = document.querySelector('.fp-label--val');

    const urlParams = new URLSearchParams(window.location.search);
    const urlPage = parseInt(urlParams.get('page') || '', 10);
    // Legacy param from the infinite-scroll era (?shown=): drop it.
    if (urlParams.has('shown')) {
      const clean = new URL(window.location);
      clean.searchParams.delete('shown');
      window.history.replaceState({}, '', clean);
    }
    const state = { 
      search: urlParams.get('q') || '', 
      type: urlParams.get('type') || 'All', 
      status: urlParams.get('status') || 'All', 
      genre: urlParams.get('genre') || 'All', 
      year: urlParams.get('year') || 'All', 
      page: urlPage > 1 ? urlPage - 1 : 0
    };

    if (state.search) searchInput.value = state.search;
    if (state.type !== 'All') typeSelect.value = state.type;
    if (state.status !== 'All') statusSelect.value = state.status;
    if (state.genre !== 'All') genreSelect.value = state.genre;
    if (state.year !== 'All') yearSelect.value = state.year;
    pageSizeSelect.value = String(pageSize);

    function updateURL() {
      const url = new URL(window.location);
      state.search ? url.searchParams.set('q', state.search) : url.searchParams.delete('q');
      state.type !== 'All' ? url.searchParams.set('type', state.type) : url.searchParams.delete('type');
      state.status !== 'All' ? url.searchParams.set('status', state.status) : url.searchParams.delete('status');
      state.genre !== 'All' ? url.searchParams.set('genre', state.genre) : url.searchParams.delete('genre');
      state.year !== 'All' ? url.searchParams.set('year', state.year) : url.searchParams.delete('year');
      state.page > 0
        ? url.searchParams.set('page', state.page + 1)
        : url.searchParams.delete('page');
      window.history.replaceState({}, '', url);
    }

    function applyFilters() {
      const q = state.search.trim().toLowerCase();
      return entries.filter((e) => {
        const searchOk = !q || e.title.toLowerCase().includes(q);
        const typeOk = state.type === 'All' || e.type === state.type;
        const statusOk = state.status === 'All' || e.status === state.status;
        const genreOk = state.genre === 'All' || e.genres.includes(state.genre);
        const yearOk = state.year === 'All' || String(e.year) === state.year;
        return searchOk && typeOk && statusOk && genreOk && yearOk;
      });
    }

    // Why is it empty? The search term is judged on its own so we can tell
    // "your query matched nothing" apart from "your query matched, but the
    // filters are hiding the results" — the second case is a silent failure
    // worth calling out with a one-click way out.
    function searchOnlyMatches() {
      const q = state.search.trim().toLowerCase();
      if (!q) return [];
      return entries.filter((e) => e.title.toLowerCase().includes(q));
    }

    // `prefix` names the filter's kind. It's no longer shown — the pill shape
    // and × already say "this is a removable filter" — but it stays in the
    // aria-label, where a bare "Ongoing" would be unexplained.
    function activeConstraints() {
      const out = [];
      if (state.search.trim()) out.push({ key: 'search', label: state.search.trim(), prefix: '' });
      if (state.type !== 'All') out.push({ key: 'type', label: state.type, prefix: 'Type' });
      if (state.status !== 'All') out.push({ key: 'status', label: state.status, prefix: 'Status' });
      if (state.genre !== 'All') out.push({ key: 'genre', label: state.genre, prefix: 'Genre' });
      if (state.year !== 'All') out.push({ key: 'year', label: state.year, prefix: 'Year' });
      return out;
    }

    // Standing filter row: deep links and filter changes narrow the catalog,
    // but opening the whole panel unprompted was intrusive. Name only what's
    // actually active, with a way to drop each one.
    //
    // Yields to the panel while it's open — the pills there already highlight
    // every active filter, so showing both just repeats the same list.
    // The announcement sits under the header but yields to the filter UI —
    // it shows only when the panel is closed AND nothing is filtered, so the
    // results keep the top of the page once you're narrowing them. `until`
    // is checked here rather than only at build time, so the bar expires on
    // its own date even if the site hasn't been redeployed since.
    //
    // `data-dismissed` is set by the inline script when this visitor already
    // closed this exact message. It has to be re-read here: this function
    // REWRITES `hidden` on load and on every filter change, so without it the
    // bar would come straight back after being dismissed.
    function syncAnnounce(constraints) {
      if (!announceBar) return;
      const until = announceBar.dataset.until;
      const expired = until ? new Date(`${until}T23:59:59`) < new Date() : false;
      const dismissed = announceBar.dataset.dismissed === '1';
      announceBar.hidden = expired || dismissed || !filterPanel.hidden || constraints.length > 0;
      syncAnnounceScroll();
    }

    // Fill the track with as many copies of the line as it takes to overrun
    // the strip. Two copies isn't enough on a wide desktop — the strip is
    // wider than two copies, so a gap would scroll through view. The count
    // comes from the strip's real width, so it re-solves on resize too.
    //
    // Speed stays a constant DRIFT RATE (~38px/s), not a fixed duration: the
    // duration is one copy's width over that rate, so a longer message takes
    // proportionally longer instead of racing past.
    function syncAnnounceScroll() {
      if (!announceBar || announceBar.hidden) return;
      const vp = announceBar.querySelector('.announce-viewport');
      const track = announceBar.querySelector('.announce-track');
      const text = announceBar.dataset.text;
      if (!vp || !track || !text) return;

      const unit = track.firstElementChild.getBoundingClientRect().width;
      if (!unit) return;
      // Two copies minimum (one to show, one to take its place), then enough
      // more to cover the strip plus one spare to hide the loop's edge.
      const copies = Math.max(2, Math.ceil(vp.clientWidth / unit) + 2);

      if (track.children.length !== copies) {
        // Built with textContent, not innerHTML — the string is developer-
        // authored today, but it never needs to be trusted as markup.
        const frag = document.createDocumentFragment();
        for (let i = 0; i < copies; i += 1) {
          const span = document.createElement('span');
          span.className = 'announce-item';
          span.textContent = text;
          if (i > 0) span.setAttribute('aria-hidden', 'true');
          frag.appendChild(span);
        }
        track.replaceChildren(frag);
        announceBar.style.setProperty('--n', String(copies));
      }

      announceBar.style.setProperty('--dur', `${(unit / 38).toFixed(1)}s`);
      announceBar.classList.add('is-scrolling');
    }

    // rAF-throttled: reading offsetWidth forces layout, and resize fires
    // continuously while a window is being dragged.
    let announceRaf = 0;
    window.addEventListener('resize', () => {
      cancelAnimationFrame(announceRaf);
      announceRaf = requestAnimationFrame(syncAnnounceScroll);
    }, { passive: true });

    // The number window is 3 wide on phones and 5 elsewhere, so it must be
    // rebuilt when the layout crosses 640px — otherwise a rotated phone or a
    // dragged desktop window keeps the old width's numbers. Only act when the
    // narrow/wide state actually FLIPS, so a plain drag within one side costs
    // nothing (resize fires continuously while dragging).
    //
    // `narrow` is declared HERE, not down beside pageNumbers(): this line runs
    // immediately at registration, and a const declared further down the module
    // is in its temporal dead zone until then — the whole script threw
    // "Cannot access 'narrow' before initialization" and nothing rendered.
    const narrow = () => window.matchMedia('(max-width: 640px)').matches;

    let wasNarrow = narrow();
    let pagerRaf = 0;
    window.addEventListener('resize', () => {
      cancelAnimationFrame(pagerRaf);
      pagerRaf = requestAnimationFrame(() => {
        if (narrow() === wasNarrow) return;
        wasNarrow = narrow();
        // renderPage() rebuilds grid + numbers + arrows together, so the window
        // can't get out of step with the filter state the way patching
        // numbers.innerHTML on its own would.
        renderPage();
      });
    }, { passive: true });

    // The progress line is what says "delivered": when its ONE pass ends the
    // strip is marked done and the close button promotes from 45% to full
    // opacity. It stays clickable the whole time — a ~20s pass is far too
    // long to make anyone wait before they can dismiss a notice.
    //
    // Under reduced motion there is no pass, so no event ever fires and the
    // button simply keeps its quiet opacity (CSS already pins it to full
    // there, where the message is readable immediately).
    announceBar?.querySelector('.announce-progress')
      ?.addEventListener('animationend', () => announceBar.classList.add('is-done'));

    // Dismissal is remembered per MESSAGE, not as a yes/no flag — the stored
    // value is a hash of this text. So it stays gone for this visitor, but a
    // new announcement written in config.ts won't match and will show again
    // for everyone who dismissed the old one. No expiry date to manage, and
    // no way to accidentally mute future announcements.
    document.getElementById('announce-x')?.addEventListener('click', () => {
      try {
        localStorage.setItem(
          'aura-announce-dismissed',
          window.announceHash(announceBar.dataset.text || ''),
        );
      } catch (e) {
        /* storage blocked (private mode) — it just reappears next load */
      }
      // Flag immediately, not just on next load: syncAnnounce() runs again on
      // any filter change or panel toggle and would otherwise restore the bar
      // mid-fade.
      announceBar.dataset.dismissed = '1';
      // Fade, then hide. Not a height animation: the grid reclaims its 1.5rem
      // top padding the instant the bar is [hidden], so a collapsing bar
      // would fall past the resting position and bounce back up. Fading in
      // place and then hiding matches how the filter panel already yields.
      announceBar.classList.add('is-dismissing');
      window.setTimeout(() => {
        announceBar.hidden = true;
        announceBar.classList.remove('is-dismissing');
      }, 200);
    });

    function renderActiveFilters() {
      const constraints = activeConstraints();
      syncAnnounce(constraints);
      const show = constraints.length > 0 && filterPanel.hidden;
      activeFilters.hidden = !show;
      if (!show) {
        if (!constraints.length) activeFilters.innerHTML = '';
        return;
      }
      const chips = constraints
        .map((c) => `<button type="button" class="af-chip" data-af-drop="${c.key}"
            aria-label="Remove filter ${escapeHTML(c.prefix ? c.prefix + ': ' : '')}${escapeHTML(c.label)}">${escapeHTML(c.label)}<span class="af-x" aria-hidden="true">&times;</span></button>`)
        .join('');
      // Chips scroll in their own strip so the row stays one line at any
      // width — same idea as the season strip. No Clear button: every
      // constraint carries its own ×, and there are rarely more than three.
      activeFilters.innerHTML = `<div class="af-scroll">${chips}</div>`;
      syncAfScroll();
    }

    // Edge fade = "more filters this way", only when the strip overflows.
    function syncAfScroll() {
      const sc = activeFilters.querySelector('.af-scroll');
      if (!sc) return;
      const canScroll = sc.scrollWidth - sc.clientWidth > 1;
      sc.classList.toggle('is-scrollable', canScroll);
      sc.classList.toggle(
        'at-end',
        !canScroll || sc.scrollLeft + sc.clientWidth >= sc.scrollWidth - 1
      );
    }

    activeFilters.addEventListener('scroll', syncAfScroll, { passive: true });
    window.addEventListener('resize', syncAfScroll);

    const EMPTY_ICON = `<svg class="empty-ico" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line><line x1="8" y1="11" x2="14" y2="11"></line></svg>`;

    function renderEmpty() {
      const constraints = activeConstraints();
      const soloHits = searchOnlyMatches();

      // Nothing set at all: the catalog itself is empty, filters aren't to blame.
      if (!constraints.length) {
        emptyState.innerHTML = `${EMPTY_ICON}
          <p class="empty-title">Nothing here yet</p>
          <p class="empty-sub">No titles have been added yet. Check back soon.</p>`;
        return;
      }

      // The query matched, but the filters are hiding those results.
      if (soloHits.length && constraints.some((c) => c.key !== 'search')) {
        const n = soloHits.length;
        emptyState.innerHTML = `${EMPTY_ICON}
          <p class="empty-title">Hidden by your filters</p>
          <p class="empty-sub">${n} ${n === 1 ? 'title matches' : 'titles match'}
            &ldquo;${escapeHTML(state.search.trim())}&rdquo; &mdash; your filters are hiding
            ${n === 1 ? 'it' : 'them'}.</p>
          <button type="button" class="empty-cta" data-empty-show>Show them anyway</button>`;
        return;
      }

      // A search term with no filters: nothing to remove, so don't pretend
      // there is — name the miss and offer to clear just the query.
      if (constraints.length === 1 && constraints[0].key === 'search') {
        emptyState.innerHTML = `${EMPTY_ICON}
          <p class="empty-title">No matching titles</p>
          <p class="empty-sub">
            Check the spelling of &ldquo;${escapeHTML(state.search.trim())}&rdquo;,
            or clear your search to browse all titles.</p>
          <button type="button" class="empty-cta" data-empty-drop="search">Clear search</button>`;
        return;
      }

      // Otherwise: name each culprit and let it be dropped one at a time.
      const chips = constraints
        .map((c) => `<button type="button" class="empty-chip" data-empty-drop="${c.key}"
            aria-label="Remove filter ${escapeHTML(c.label)}">${escapeHTML(c.label)}
            <span class="empty-chip-x" aria-hidden="true">&times;</span></button>`)
        .join('');
      emptyState.innerHTML = `${EMPTY_ICON}
        <p class="empty-title">Nothing matches yet</p>
        <p class="empty-sub">New titles will appear here as they’re added.</p>
        <div class="empty-chips">${chips}</div>
        <button type="button" class="empty-cta" data-empty-clear>Clear all filters</button>`;
    }

    let currentFiltered: CatalogItem[] = [];

    async function renderPage() {
      // Filtering needs the whole catalog, which the HTML no longer carries.
      await ensureEntries();
      currentFiltered = applyFilters();
      const pages = Math.max(1, Math.ceil(currentFiltered.length / pageSize));
      state.page = Math.max(0, Math.min(state.page, pages - 1));
      updateURL();

      const start = state.page * pageSize;
      const visibleItems = currentFiltered.slice(start, start + pageSize);
      grid.innerHTML = visibleItems.map(cardHTML).join('');

      const isEmpty = currentFiltered.length === 0;
      emptyState.hidden = !isEmpty;
      pager.hidden = isEmpty;
      if (isEmpty) renderEmpty();
      // The empty state names the culprits itself; showing both would repeat.
      if (isEmpty) activeFilters.hidden = true;
      else renderActiveFilters();
      // Keep the panel's active-pill highlight in step with the state.
      syncSelectStates();

      if (!isEmpty) {
        // No "Showing 1–3 of 3" line: the highlighted page number already says
        // where you are, and the cards below ARE the count. It was also the
        // widest thing in the bar, and keeping it meant the numbers had to be
        // hidden on phones. (The episode pager on detail pages keeps its count
        // — there it's the only thing saying "episode 40 of 221".)
        firstBtn.disabled = state.page === 0;
        prevBtn.disabled = state.page === 0;
        nextBtn.disabled = state.page === pages - 1;
        lastBtn.disabled = state.page === pages - 1;
        numbers.innerHTML = pageNumbers(state.page, pages);
      }
    }

    // Windowed page numbers: up to 5 around current (3 on a phone), first and
    // last pinned behind an ellipsis.
    //
    // The window shrinks on narrow screens because the row has to fit alongside
    // the arrows. Measured required width at 390px viewport (350px usable):
    //
    //   < 1 … 4 5 6 … 20 >          294px   fits
    //   < 1 … 3 4 5 6 7 … 20 >      377px   overflows
    //
    // The « and » (first/last) buttons are dropped below 640px for the same
    // reason — they cost 104px and are redundant once numbers show, since the
    // window already pins the first and last page as clickable buttons.
    // (`narrow` is declared up with the resize listener — see the note there.)
    function pageNumbers(p, pages) {
      const size = narrow() ? 3 : 5;
      const half = Math.floor(size / 2);
      let start = Math.max(0, p - half);
      start = Math.min(start, Math.max(0, pages - size));
      const end = Math.min(pages, start + size);
      let html = '';
      if (start > 0) {
        html += numBtn(0, p) + '<span class="cat-ellipsis" aria-hidden="true">…</span>';
      }
      for (let i = start; i < end; i++) {
        html += numBtn(i, p);
      }
      if (end < pages) {
        html += '<span class="cat-ellipsis" aria-hidden="true">…</span>' + numBtn(pages - 1, p);
      }
      return html;
    }

    function numBtn(i, p) {
      const active = i === p ? ' is-active' : '';
      const current = i === p ? ' aria-current="page"' : '';
      const disabled = i === p ? ' disabled' : '';
      return `<button type="button" class="ep-page-btn cat-num${active}" data-p="${i}" aria-label="Page ${i + 1}"${current}${disabled}>${i + 1}</button>`;
    }

    // prefers-reduced-motion: the 'smooth' option ignores it, so ask first.
    const scrollBehavior = () =>
      window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';

    // scrollIntoView parks the grid at viewport y=0, but the site header is
    // sticky — so the first row of results slid underneath it. Leave room for
    // the header (same approach as the detail page's scrollToEpisodesTop).
    function scrollToGridTop() {
      const sticky =
        getComputedStyle(header).position === 'sticky' ? header.offsetHeight : 0;
      const y = grid.getBoundingClientRect().top + window.scrollY - sticky - 12;
      window.scrollTo({ top: Math.max(0, y), behavior: scrollBehavior() });
    }

    // The filter panel has the identical problem, in reverse. Its toggle is
    // in the sticky header — always reachable at any scroll depth — while the
    // panel itself sits in normal flow at the top of the catalog. So clicking
    // the icon after scrolling down opened it several screens above the
    // viewport and the user saw nothing happen. Take them to it, leaving the
    // same room for the header as scrollToGridTop does.
    // Narrowed explicitly: querySelector gives Element (no offsetHeight) and
    // getElementById gives T | null, so both would otherwise add to the
    // project's pre-existing type-error count.
    function scrollToFilterTop() {
      if (!(filterPanel instanceof HTMLElement) || !(header instanceof HTMLElement)) return;
      const sticky =
        getComputedStyle(header).position === 'sticky' ? header.offsetHeight : 0;
      const y = filterPanel.getBoundingClientRect().top + window.scrollY - sticky - 12;
      window.scrollTo({ top: Math.max(0, y), behavior: scrollBehavior() });
    }

    function gotoPage(p, scrollTop = true) {
      state.page = p;
      renderPage();
      if (scrollTop) {
        scrollToGridTop();
      }
    }

    // Header search applies on Enter (form submit).
    searchInput.closest('form').addEventListener('submit', (e) => {
      e.preventDefault();
      state.search = searchInput.value;
      state.page = 0;
      renderPage();
      scrollToGridTop();
    });

    // Filter panel toggle (button lives in the site header).
    filterToggle.hidden = false;
    filterToggle.addEventListener('click', () => {
      const open = filterPanel.hidden;
      filterPanel.hidden = !open;
      filterToggle.setAttribute('aria-expanded', String(open));
      // The chip row yields to the panel, so it has to come back on close.
      renderActiveFilters();
      // Scroll only after that reflow: opening also hides the announcement
      // bar, which sits ABOVE the panel, so measuring first would aim at a
      // position the panel has already moved out of.
      if (open) scrollToFilterTop();
    });

    // A deep link (/?year=2017, /?genre=Action, /?q=…) narrows the catalog, but
    // popping the whole filter panel open unprompted was intrusive — on mobile
    // it shoved the results down the page. The standing chip row above the grid
    // names what's active instead; the panel only opens on request.
    renderActiveFilters();

    typeSelect.addEventListener('change', () => { state.type = typeSelect.value; state.page = 0; renderPage(); });
    statusSelect.addEventListener('change', () => { state.status = statusSelect.value; state.page = 0; renderPage(); });
    genreSelect.addEventListener('change', () => { state.genre = genreSelect.value; state.page = 0; renderPage(); });
    yearSelect.addEventListener('change', () => { state.year = yearSelect.value; state.page = 0; renderPage(); });

    function setPageSize(v) {
      pageSize = [10, 20, 50].includes(v) ? v : 10;
      try {
        localStorage.setItem('aura-page-size', String(pageSize));
      } catch (e) {
        /* private mode etc. — choice just won't persist */
      }
      pageSizeSelect.value = String(pageSize);
      // syncSelectStates() rewrites "Page/10" -> "Page/20" from this.
      state.page = 0;
      renderPage();
    }

    pageSizeSelect.addEventListener('change', () => {
      setPageSize(parseInt(pageSizeSelect.value, 10));
    });

    // A tag's × drops just that filter and hands the field back to its
    // picker. Focus stays on the field, which is now a select again.
    document.querySelector('.select-row').addEventListener('click', (e) => {
      const tag = e.target.closest('[data-fp-drop]');
      if (!tag) return;
      const key = tag.dataset.fpDrop;
      state[key] = 'All';
      state.page = 0;
      syncSelects();
      renderPage();
      const field = document.querySelector(`.fp-field[data-fp="${key}"]`);
      field.querySelector('select').focus({ preventScroll: true });
    });

    // The panel no longer carries a Clear button — the standing chip row owns
    // clearing. Both it and the empty state call this.
    function clearAll() {
      state.search = ''; state.type = 'All'; state.status = 'All'; state.genre = 'All'; state.year = 'All'; state.page = 0;
      searchInput.value = ''; typeSelect.value = 'All'; statusSelect.value = 'All'; genreSelect.value = 'All'; yearSelect.value = 'All';
      renderPage();
    }

    // Swap each field between its two states: a picker (Type ⌄) while unset,
    // a tag (Movie ×) once chosen. Page is excluded — it's a setting, so it
    // keeps its picker and only its label changes to carry the value.
    function syncSelectStates() {
      const map = [
        ['type', typeSelect],
        ['status', statusSelect],
        ['genre', genreSelect],
        ['year', yearSelect],
      ];
      for (const [key, sel] of map) {
        const field = document.querySelector(`.fp-field[data-fp="${key}"]`);
        const chosen = sel.value !== 'All';
        field.classList.toggle('is-set', chosen);
        sel.classList.toggle('is-active', chosen);
        const tag = field.querySelector('.fp-tag');
        tag.hidden = !chosen;
        if (chosen) {
          const text = field.querySelector('.fp-tag-text');
          text.textContent = sel.value;
          tag.setAttribute('aria-label', `Remove ${key} filter ${sel.value}`);
        }
      }
      // Page/10 — the label is the value, since Page never becomes a tag.
      pageLabel.textContent = `Page/${pageSize}`;
    }

    // Empty-state controls: drop one constraint, or drop every filter while
    // keeping the query that actually matched.
    const syncSelects = () => {
      typeSelect.value = state.type;
      statusSelect.value = state.status;
      genreSelect.value = state.genre;
      yearSelect.value = state.year;
      searchInput.value = state.search;
    };

    emptyState.addEventListener('click', (e) => {
      const drop = e.target.closest('[data-empty-drop]');
      if (drop) {
        const k = drop.dataset.emptyDrop;
        if (k === 'search') state.search = '';
        else state[k] = 'All';
        state.page = 0;
        syncSelects();
        renderPage();
        // The chip is gone after re-render — don't strand the keyboard on
        // <body>. Stay in the empty state, or move to the results it produced.
        if (!emptyState.hidden) emptyState.focus({ preventScroll: true });
        else grid.focus({ preventScroll: true });
        return;
      }
      if (e.target.closest('[data-empty-show]')) {
        // The query works — the filters are the problem. Keep the search.
        state.type = 'All'; state.status = 'All'; state.genre = 'All'; state.year = 'All';
        state.page = 0;
        syncSelects();
        renderPage();
        return;
      }
      if (e.target.closest('[data-empty-clear]')) clearAll();
    });

    // Standing chip row: drop one constraint, or drop them all.
    activeFilters.addEventListener('click', (e) => {
      const drop = e.target.closest('[data-af-drop]');
      if (drop) {
        const k = drop.dataset.afDrop;
        if (k === 'search') state.search = '';
        else state[k] = 'All';
        state.page = 0;
        syncSelects();
        renderPage();
        // The chip is gone after re-render — keep the keyboard in the row if
        // it survived, otherwise move to the results it produced.
        const next = activeFilters.querySelector('.af-chip');
        if (!activeFilters.hidden && next) next.focus({ preventScroll: true });
        else grid.focus({ preventScroll: true });
        return;
      }
    });

    prevBtn.addEventListener('click', () => gotoPage(state.page - 1));
    nextBtn.addEventListener('click', () => gotoPage(state.page + 1));
    firstBtn.addEventListener('click', () => gotoPage(0));
    lastBtn.addEventListener('click', () => gotoPage(Number.MAX_SAFE_INTEGER));
    numbers.addEventListener('click', (e) => {
      const btn = e.target.closest('button[data-p]');
      if (btn) gotoPage(parseInt(btn.dataset.p, 10));
    });

    // Initial render. The server already put the first page of cards in the
    // HTML, so a plain visit to a catalog that fits on one page is finished —
    // no fetch, no re-render, no JS needed to read it. Anything else (a
    // deep-linked filter or ?page=, or more titles than this page size)
    // brings the lazily-fetched index along. syncSelectStates() still runs:
    // it sizes the Page/NN label and the field pills, and needs no index.
    syncSelectStates();
    const total = Number(grid?.dataset.total || 0);
    const deepLinked =
      state.search !== '' ||
      state.type !== 'All' ||
      state.status !== 'All' ||
      state.genre !== 'All' ||
      state.year !== 'All' ||
      state.page > 0;
    if (total === 0 || deepLinked || total > pageSize) renderPage();
  </script>
</Base>