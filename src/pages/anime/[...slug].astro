---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { downloadUrl, POSTER_FALLBACK, SITE_URL } from '../../config';
import { epLabel, EP_PAGE_SIZE } from '../../lib/episodes';
import { getEpisodeData } from '../../lib/episode-data';
import type { Season } from '../../lib/episode-schema';
import { synopsisDescription } from '../../lib/description';

// One route per (title × season × page). Episodes are paginated at build time
// into real URLs, so a 1000-episode season ships ~EP_PAGE_SIZE rows per page
// instead of the whole list — and every page (tabs, Prev/Next, jump) works
// without JavaScript, because it's all server-rendered HTML.
//
// URL shapes:
//   /anime/<id>/            → first season, first page
//   /anime/<id>/s<N>/       → season N, first page   (N ≥ 2; season 1 is bare)
//   /anime/<id>/s<N>/<P>/   → season N, page P
//   /anime/<id>/<P>/        → single-season title, page P  (P ≥ 2)
type PathProps = {
  entry: CollectionEntry<'anime'>;
  seasonList: Season[];
  seasonNum: number;
  page: number;
  totalPages: number;
};

export async function getStaticPaths() {
  // zz-sample-* entries are local layout fixtures — built only in dev.
  const entries = (await getCollection('anime')).filter(
    (e) => import.meta.env.DEV || !e.id.startsWith('zz-sample-')
  );

  const paths: {
    params: { slug: string };
    props: PathProps;
  }[] = [];

  for (const entry of entries) {
    const { episodes, seasons } = getEpisodeData(entry);
    // Normalise to a season list. A title with no `seasons` is one season
    // carrying the flat `episodes` array.
    const seasonList: Season[] = seasons.length
      ? [...seasons].sort((a, b) => a.season - b.season)
      : [
          {
            season: 1,
            status: entry.data.status,
            totalEpisodes: entry.data.totalEpisodes,
            episodes: episodes ?? [],
          },
        ];
    const multi = seasonList.length > 1;

    for (const s of seasonList) {
      const eps = s.episodes ?? [];
      const pages = Math.max(1, Math.ceil(eps.length / EP_PAGE_SIZE));
      for (let p = 1; p <= pages; p++) {
        const segs = [entry.id];
        if (multi && s.season !== 1) segs.push(`s${s.season}`);
        if (p > 1) segs.push(String(p));
        paths.push({
          params: { slug: segs.join('/') },
          props: { entry, seasonList, seasonNum: s.season, page: p, totalPages: pages },
        });
      }
    }
  }
  return paths;
}

const { entry, seasonList, seasonNum, page, totalPages } = Astro.props;
const { Content } = await render(entry);
const {
  title,
  titleNative,
  poster,
  genres,
  type,
  year,
  status,
  rating,
  totalEpisodes,
  aiAssisted,
} = entry.data;

const multi = seasonList.length > 1;
const current = seasonList.find((s) => s.season === seasonNum) ?? seasonList[0];
const allEpisodes = current.episodes ?? [];
const start = (page - 1) * EP_PAGE_SIZE;
const pageEpisodes = allEpisodes.slice(start, start + EP_PAGE_SIZE);
const hasEpisodes = allEpisodes.length > 0;
const srcLabel = (n: number) => `${n} source${n === 1 ? '' : 's'}`;

// Poster badge: latest season's count wins when seasons exist.
const latestSeason = seasonList[seasonList.length - 1] ?? null;
const badgeTotal = latestSeason?.totalEpisodes ?? totalEpisodes;
const epValue = epLabel(badgeTotal);
const currentCount = epLabel(current.totalEpisodes);

// Detail-poster season badge (same range/+N rule as the card).
const seasonNums = seasonList.map((s) => s.season);
const seasonBadge = (() => {
  if (seasonNums.length < 2) return '';
  const sorted = [...seasonNums].sort((a, b) => a - b);
  if (sorted.every((s, i) => i === 0 || s === sorted[i - 1] + 1)) {
    return `S${sorted[0]}–S${sorted[sorted.length - 1]}`;
  }
  if (sorted.length <= 3) return sorted.map((s) => `S${s}`).join('·');
  return sorted.slice(0, 3).map((s) => `S${s}`).join('·') + `·+${sorted.length - 3}`;
})();

// Route helpers. Season 1 (and single-season titles) live at the bare base;
// later seasons add an `s<N>/` segment. Page 1 is always the bare season URL.
const base = `/anime/${entry.id}/`;
const seasonUrl = (n: number) => (multi && n !== 1 ? `${base}s${n}/` : base);
const pageUrl = (n: number, p: number) => (p <= 1 ? seasonUrl(n) : `${seasonUrl(n)}${p}/`);
// Prev/next carry an #episodes anchor so a page change keeps the view on the
// episode list instead of jumping to the top of the page (see the script).
const prevUrl = page > 1 ? pageUrl(seasonNum, page - 1) + '#episodes' : null;
const nextUrl = page < totalPages ? pageUrl(seasonNum, page + 1) + '#episodes' : null;

// Episode numbers in this season, in order — the client uses them to work out
// which page (and URL) a jumped-to episode lives on.
const epNums = allEpisodes.map((e) => e.ep);

// Per-title meta description. '' means nothing usable survived extraction —
// Base then falls back to the site default rather than emitting an empty tag.
const description = synopsisDescription(entry.body);

// Structured data telling crawlers which work this page is about. Deliberately
// no aggregateRating (third-party score, not user ratings) and no
// numberOfEpisodes (the badge is the latest season's count, not a total).
const seriesSchema = {
  '@context': 'https://schema.org',
  '@type': type === 'Movie' ? 'Movie' : 'TVSeries',
  name: title,
  ...(titleNative && { alternateName: titleNative }),
  url: `${SITE_URL}/anime/${entry.id}`,
  image: poster,
  genre: genres.join(', '),
  ...(year && { datePublished: String(year) }),
};
---

<Base
  title={`${title} — aniXsubs`}
  description={description || undefined}
  schema={seriesSchema}
>
  <article class="detail">
  <div class="detail-side">
    <div class="detail-poster-wrap">
      {/* onerror: posters are i.pinimg.com links and those get taken down. */}
      <img
        class="detail-poster"
        src={poster}
        alt={`${title} cover art`}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        onerror={`this.onerror=null;this.src='${POSTER_FALLBACK}';`}
      />
      {rating != null && (
        <span class="rating-badge rating-badge-lg">★ {rating.toFixed(1)}</span>
      )}
      {epValue && (
        <span class="episode-badge episode-badge-lg">
          <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <rect x="1.5" y="3.5" width="13" height="9" rx="1.3" stroke="currentColor" stroke-width="1.3" />
            <path d="M6.5 6.2 10 8l-3.5 1.8V6.2Z" fill="currentColor" />
          </svg>
          {epValue}
        </span>
      )}
      {seasonBadge && (
        <span class="season-badge season-badge-lg">{seasonBadge}</span>
      )}
    </div>

    {/* Deep links into the catalog's filters on the home page. */}
    <div class="detail-eyebrow">
      {year && <a class="eyebrow-year" href={`/?year=${year}`}>{year}</a>}
      {status && (
        <a
          class={`eyebrow-status status-${status.toLowerCase()}`}
          href={`/?status=${encodeURIComponent(status)}`}
        >
          {status}
        </a>
      )}
      {type && (
        <a class="eyebrow-type" href={`/?type=${encodeURIComponent(type)}`}>
          {type}
        </a>
      )}
    </div>

    <ul class="genre-tags">
      {genres.map((g) => (
        <li>
          <a href={`/?genre=${encodeURIComponent(g)}`}>{g}</a>
        </li>
      ))}
    </ul>
  </div>

  <div class="content-wrapper">
    <a class="back-link" href="/" onclick="if(history.length>1){history.back();return false;}">&larr; Back</a>

    <h1 class="detail-title">{title}</h1>
    {titleNative && <p class="detail-native">{titleNative}</p>}

    <div class="synopsis-head">
      <h3 class="synopsis-heading">Story</h3>
    </div>

    <div class="synopsis-block">
      <div class="synopsis" id="synopsis">
        <Content />
        {aiAssisted && (
          <p class="ai-credit">[AI-assisted synopsis]</p>
        )}
      </div>

      <button
        type="button"
        class="synopsis-toggle"
        id="synopsis-toggle"
        aria-expanded="true"
        aria-controls="synopsis"
        hidden
      >
        <span data-synopsis-label>Read more</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </button>
    </div>

      {hasEpisodes && (
        <div class="episodes-section" id="episodes">
          <div class="episodes-head">
            <h3 class="episodes-heading">Episodes & Downloads</h3>
          </div>

          {/* Season tabs are real links now — clicking one navigates to that
              season's first page, so it works without JS and survives reloads.
              The active season is marked aria-current="page". */}
          <div class={`season-row${multi ? '' : ' is-solo'}`}>
            {multi && (
              <nav class="season-tabs" aria-label="Seasons">
                {seasonList.map((s) => (
                  <a
                    href={pageUrl(s.season, 1) + '#episodes'}
                    class="season-tab"
                    aria-current={s.season === seasonNum ? 'page' : undefined}
                  >S{s.season}</a>
                ))}
              </nav>
            )}

            <span class="ep-jump">
              <label for="ep-jump-input">EP</label>
              <input
                id="ep-jump-input"
                class="ep-jump-input"
                inputmode="numeric"
                pattern="[0-9]*"
                min="1"
                placeholder="e.g. 5"
                aria-label="Jump to episode number in the current season"
              />
            </span>

            {/* Status + episode-count pills for the current season. */}
            <div class="season-meta">
              {current.status && (
                <span class={`season-status status-${current.status.toLowerCase()}`}>
                  <span class="status-dot" aria-hidden="true"></span>
                  {current.status}
                </span>
              )}
              {currentCount && <span class="season-count">{currentCount}</span>}
            </div>
          </div>

          <p class="ep-jump-msg" id="ep-jump-msg" role="status" hidden></p>

          {/* Only this page's slice of episodes is in the HTML. */}
          <div class="episodes-list">
            {pageEpisodes.map((episode) => (
              <details class="ep-accordion" data-ep={episode.ep}>
                <summary class="ep-header">
                  <div class="ep-title-wrap">
                    <span class="ep-number">EP {String(episode.ep).padStart(2, '0')}</span>
                    {episode.title && <span class="ep-title">{episode.title}</span>}
                    <span class="ep-sources">{srcLabel(episode.downloads.length)}</span>
                  </div>
                  <div class="ep-chevron">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg>
                  </div>
                </summary>

                <div class="dl-table">
                  <div class="dl-rows">
                    {episode.downloads.map((dl) => (
                      <a href={downloadUrl(dl.link)} target="_blank" rel="noopener noreferrer" class="dl-row">
                        <span class="dl-info">
                          <svg class="dl-icon-front" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                            <polyline points="7 10 12 15 17 10"></polyline>
                            <line x1="12" y1="15" x2="12" y2="3"></line>
                          </svg>
                          <span class="dl-source">{dl.source}</span>
                          <span class="badge badge-quality">{dl.format.toUpperCase()}</span>
                          <span class="badge badge-quality">{dl.quality}</span>
                          <span class="badge badge-size">{dl.size}</span>
                        </span>
                        <svg class="dl-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <line x1="5" y1="12" x2="19" y2="12"></line>
                          <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                      </a>
                    ))}
                  </div>
                </div>
              </details>
            ))}
          </div>

          {/* Real pagination: Prev/Next are links to the adjacent pages, so they
              work without JS. The count always shows where you are. */}
          <div class="ep-pager ep-pager-bottom">
            <p class="ep-count">
              Showing {start + 1}–{start + pageEpisodes.length} of {allEpisodes.length}
            </p>
            {(prevUrl || nextUrl) && (
              <div class="ep-pager-controls">
                {prevUrl && (
                  <a href={prevUrl} class="ep-page-btn" rel="prev" aria-label="Previous page">&lt;</a>
                )}
                {nextUrl && (
                  <a href={nextUrl} class="ep-page-btn" rel="next" aria-label="Next page">&gt;</a>
                )}
              </div>
            )}
          </div>
        </div>
      )}

      <p class="notice">
        {hasEpisodes ? (
          <>
            <span class="notice-label">Note:</span>{' '}
            <span class="notice-term">Telegram Bot</span> not opening? Turn on your{' '}
            <span class="notice-key">VPN</span> and retry.
          </>
        ) : (
          <>
            <span class="notice-eyebrow">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
              Episodes
            </span>
            <span class="notice-body">No episodes available yet. Check back soon.</span>
          </>
        )}
      </p>
    </div>
  </article>

  <script define:vars={{ EP_PAGE_SIZE, epNums, jumpBase: seasonUrl(seasonNum) }}>
    (() => {
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const scrollBehavior = () => (reducedMotion.matches ? 'auto' : 'smooth');

      // Arriving on the #episodes anchor (via prev/next or a season tab): park
      // the section just under the sticky header — exactly where the old
      // in-place pager left it. Without JS the CSS scroll-margin-top does this;
      // this only refines to the same precise 12px gap.
      if (window.location.hash === '#episodes') {
        const section = document.getElementById('episodes');
        const header = document.querySelector('.site-header');
        if (section && header) {
          const sticky = getComputedStyle(header).position === 'sticky' ? header.offsetHeight : 0;
          const y = section.getBoundingClientRect().top + window.scrollY - sticky - 12;
          requestAnimationFrame(() => window.scrollTo(0, Math.max(0, y)));
        }
      }

      // Synopsis: collapse to the first paragraph (with a fade on the tail)
      // and an explicit Read more / Show less button, only when there is more
      // to read. Without JS the button stays hidden and everything is visible.
      const synopsis = document.getElementById('synopsis');
      const synopsisToggle = document.getElementById('synopsis-toggle');
      if (synopsis && synopsisToggle) {
        const paras = Array.from(synopsis.children).filter(
          (el) => !el.classList.contains('ai-credit')
        );
        const first = paras[0];
        const label = synopsisToggle.querySelector('[data-synopsis-label]');
        if (first && paras.length > 1) {
          const setCollapsed = (collapsed) => {
            synopsis.classList.toggle('is-collapsed', collapsed);
            if (collapsed) {
              synopsis.classList.add('is-clipped');
              if (first.scrollHeight <= first.clientHeight + 2) {
                synopsis.classList.remove('is-clipped');
              }
            } else {
              synopsis.classList.remove('is-clipped');
            }
            synopsisToggle.setAttribute('aria-expanded', String(!collapsed));
            if (label) label.textContent = collapsed ? 'Read more' : 'Show less';
          };
          synopsisToggle.hidden = false;
          synopsisToggle.addEventListener('click', () => {
            setCollapsed(!synopsis.classList.contains('is-collapsed'));
          });
          setCollapsed(true);
        }
      }

      // Jump to an episode: work out which page it lives on in this season,
      // then navigate there with a #ep-N hash so the target page opens and
      // scrolls straight to the row.
      const jumpInput = document.getElementById('ep-jump-input');
      const jumpMsg = document.getElementById('ep-jump-msg');
      if (jumpInput && jumpMsg) {
        jumpInput.addEventListener('keydown', (e) => {
          if (e.key !== 'Enter') return;
          const raw = jumpInput.value.trim();
          if (!raw) {
            jumpInput.removeAttribute('aria-invalid');
            jumpMsg.hidden = true;
            return;
          }
          const n = parseInt(raw, 10);
          if (!n) return;
          const idx = epNums.indexOf(n);
          if (idx === -1) {
            jumpInput.setAttribute('aria-invalid', 'true');
            jumpMsg.textContent =
              `Episode ${n} isn't available yet — this season lists ` +
              `${epNums.length} episode${epNums.length === 1 ? '' : 's'} so far.`;
            jumpMsg.hidden = false;
            return;
          }
          jumpInput.removeAttribute('aria-invalid');
          jumpMsg.hidden = true;
          const p = Math.floor(idx / EP_PAGE_SIZE) + 1;
          window.location.href = (p <= 1 ? jumpBase : `${jumpBase}${p}/`) + `#ep-${n}`;
        });
      }

      // Deep-linked episode (#ep-N): open the row and bring it into view.
      const hashEp = window.location.hash.match(/^#ep-(\d+)$/);
      if (hashEp) {
        const row = document.querySelector(`.ep-accordion[data-ep="${hashEp[1]}"]`);
        if (row) {
          row.open = true;
          requestAnimationFrame(() =>
            row.scrollIntoView({ behavior: scrollBehavior(), block: 'center' })
          );
        }
      }

      // --- Season tab strip -------------------------------------------------
      // Long strips scroll sideways (11+ tabs on a phone) — keep the edge fade
      // honest and bring the active tab into view on load. Tabs are links, so
      // the only client work is layout + keyboard focus movement.
      const tabStrip = document.querySelector('.season-tabs');
      const tabs = tabStrip ? Array.from(tabStrip.querySelectorAll('.season-tab')) : [];

      function syncTabStrip() {
        if (!tabStrip) return;
        // Does "tabs + jump" fit on one line? Measured from stable widths.
        const row = tabStrip.closest('.season-row');
        if (row) {
          const cs = getComputedStyle(tabStrip);
          const pad = (parseFloat(cs.paddingLeft) || 0) + (parseFloat(cs.paddingRight) || 0);
          const gap = parseFloat(cs.columnGap) || 0;
          const kids = [...tabStrip.children];
          const stripContent =
            pad + kids.reduce((sum, el) => sum + el.offsetWidth, 0) + gap * Math.max(0, kids.length - 1);
          const jump = row.querySelector('.ep-jump');
          const jumpW = jump ? jump.getBoundingClientRect().width : 0;
          const fits = stripContent + gap + jumpW <= row.getBoundingClientRect().width + 1;
          row.classList.toggle('is-tight', !fits);
        }
        const scrollable = tabStrip.scrollWidth - tabStrip.clientWidth > 2;
        tabStrip.classList.toggle('is-scrollable', scrollable);
        tabStrip.classList.toggle(
          'at-end',
          !scrollable || tabStrip.scrollLeft + tabStrip.clientWidth >= tabStrip.scrollWidth - 2
        );
      }

      function revealTab(el) {
        if (!el || !tabStrip) return;
        const left = el.offsetLeft;
        const right = left + el.offsetWidth;
        if (left < tabStrip.scrollLeft) {
          tabStrip.scrollTo({ left: Math.max(0, left - 12), behavior: scrollBehavior() });
        } else if (right > tabStrip.scrollLeft + tabStrip.clientWidth) {
          tabStrip.scrollTo({ left: right - tabStrip.clientWidth + 12, behavior: scrollBehavior() });
        }
      }

      tabStrip?.addEventListener('scroll', syncTabStrip, { passive: true });
      window.addEventListener('resize', syncTabStrip);
      document.fonts?.ready.then(syncTabStrip);
      syncTabStrip();
      revealTab(tabStrip?.querySelector('.season-tab[aria-current="page"]'));

      // Arrow/Home/End move focus across the tab links (they navigate on
      // Enter/click), so the strip stays keyboard-operable.
      const tablist = tabStrip;
      tablist?.addEventListener('keydown', (e) => {
        const current = tabs.findIndex((t) => t === document.activeElement);
        if (current === -1) return;
        const keys = { ArrowRight: 1, ArrowLeft: -1 };
        let next;
        if (e.key in keys) next = current + keys[e.key];
        else if (e.key === 'Home') next = 0;
        else if (e.key === 'End') next = tabs.length - 1;
        else return;
        e.preventDefault();
        const target = tabs[Math.max(0, Math.min(next, tabs.length - 1))];
        target.focus();
        revealTab(target);
      });

      // --- Long-title glide -------------------------------------------------
      // Titles are always one line + "…". To read the tail: on pointer
      // devices, hovering or focusing the row glides the text sideways; on
      // touch, opening the row glides it. It glides back on leave/collapse.
      const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
      const glideRaf = new WeakMap();

      function glideTitle(title, toEnd) {
        const max = Math.max(0, title.scrollWidth - title.clientWidth);
        const prev = glideRaf.get(title);
        if (prev) cancelAnimationFrame(prev);
        glideRaf.delete(title);

        if (max < 4) {
          title.classList.remove('gliding');
          title.scrollLeft = 0;
          return;
        }

        const from = title.scrollLeft;
        const to = toEnd ? max : 0;
        if (toEnd) title.classList.add('gliding');
        const done = () => {
          glideRaf.delete(title);
          if (!toEnd) title.classList.remove('gliding');
        };
        if (Math.abs(from - to) < 1) {
          done();
          return;
        }
        if (reducedMotion.matches) {
          title.scrollLeft = to;
          done();
          return;
        }
        const dur = Math.min(3000, Math.max(900, Math.abs(to - from) / 0.4));
        const start = performance.now();
        const ease = (k) => (k < 0.5 ? 2 * k * k : 1 - Math.pow(-2 * k + 2, 2) / 2);
        const step = (now) => {
          const k = Math.min(1, (now - start) / dur);
          title.scrollLeft = from + (to - from) * ease(k);
          if (k < 1) glideRaf.set(title, requestAnimationFrame(step));
          else done();
        };
        glideRaf.set(title, requestAnimationFrame(step));
      }

      document.querySelectorAll('.ep-accordion').forEach((row) => {
        const title = row.querySelector('.ep-title');
        if (!title) return;
        const settle = () =>
          glideTitle(title, row.open || (finePointer.matches && row.matches(':hover')));
        const home = () => {
          const prev = glideRaf.get(title);
          if (prev) cancelAnimationFrame(prev);
          glideRaf.delete(title);
          if (!row.open && !row.matches(':hover')) {
            title.scrollLeft = 0;
            title.classList.remove('gliding');
          }
        };

        row.addEventListener('toggle', settle);
        if (finePointer.matches) {
          row.addEventListener('pointerenter', settle);
          row.addEventListener('pointerleave', settle);
          row.addEventListener('focusin', settle);
          row.addEventListener('focusout', settle);
        }
        window.addEventListener('resize', home);
        document.fonts?.ready.then(home);
      });
    })();
  </script>
</Base>
