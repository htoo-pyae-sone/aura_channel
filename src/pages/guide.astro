---
import Base from '../layouts/Base.astro';
import SwipeNav from '../components/SwipeNav.astro';
import { BOT_USERNAME } from '../config';

const pages = [
  { href: '/about', label: 'About' },
  { href: '/guide', label: 'Guide' },
  { href: '/terms', label: 'Terms' },
];

const guideContent = [
  {
    title: '1. Find a title',
    description:
      'Search by name, or filter by type, status, genre, and year on the home page. Select a card to open the title page.',
  },
  {
    title: '2. Choose an episode',
    description:
      'Open “Episodes & Downloads” and expand an episode. You can also enter its number in the EP box. Select a download option to open the Telegram bot with the episode link attached.',
  },
  {
    title: '3. Receive the episode',
    description:
      'Tap START in the bot chat to receive the episode. Its filename will look like [CODE] Title. Save or forward it to Saved Messages before the bot removes its copy. Bot copies are deleted after about 10 minutes.',
  },
  {
    title: '4. Choose a language',
    description:
      'Send /lang in the bot chat to switch between English and Burmese. New users start in English.',
  },
  {
    title: '5. Having trouble?',
    description:
      'If you see “Expired or invalid,” get a fresh link from the site. If the bot does not open, try connecting through a VPN. Send /start on its own to bring back the welcome card with the Website and Language buttons.',
  },
];
---

<Base title="User Guide — aniXsubs">
  <article class="page-container">
    <a class="back-link" href="/" onclick="if(history.length>1){history.back();return false;}">&larr; Back</a>
    <header class="page-header">
      <h1 class="page-title">User <span class="highlight">Guide</span></h1>
      <p class="page-subtitle">How the site and the bot work together</p>
    </header>

    <section class="content-block terms-block">
      <h2>How to use the site &amp; bot</h2>
      <ul>
        {guideContent.map((item) => (
          <li>
            <strong>{item.title}</strong>
            <p>{item.description}</p>
          </li>
        ))}
      </ul>
    </section>

    <SwipeNav pages={pages} current="/guide" />
  </article>
</Base>
