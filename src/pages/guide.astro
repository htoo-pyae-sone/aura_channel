---
import Base from '../layouts/Base.astro';
import SwipeNav from '../components/SwipeNav.astro';
import { BOT_USERNAME } from '../config';

const pages = [
  { href: '/about', label: 'About' },
  { href: '/guide', label: 'Guide' },
  { href: '/terms', label: 'Terms' },
];

const guideContent = [
  {
    title: '1. Find a title',
    description:
      'Search by name, or filter by type, status, genre, and year on the home page. Tap a card to open its page.',
  },
  {
    title: '2. Download an episode',
    description:
      'Open “Episodes & Downloads”, expand an episode (or type its number in the EP box), then tap a download row. It opens the Telegram bot with your link already attached.',
  },
  {
    title: '3. Receive the file',
    description:
      'Press START in the bot and the episode arrives named [CODE] Title. For large files, forward it to Saved Messages straight away — bot copies auto-delete after about 30 minutes.',
  },
  {
    title: '4. Inline shortcut',
    description:
      `In any chat (Saved Messages works well), type @${BOT_USERNAME} followed by a CODE or a title, then tap the result. The file lands there directly — handy when downloads are slow.`,
  },
  {
    title: '5. Language',
    description:
      'Send /lang in the bot chat to switch between English and Myanmar. New users start in English.',
  },
  {
    title: '6. Trouble?',
    description:
      'An “Expired or invalid” link means it has gone stale — take a fresh one from the site. If the bot will not open, turn on a VPN and retry. Sending /start on its own brings back the welcome card with the Website and Language buttons.',
  },
];
---

<Base title="User Guide — aniXsubs">
  <article class="page-container">
    <a class="back-link" href="/" onclick="if(history.length>1){history.back();return false;}">&larr; Back</a>
    <header class="page-header">
      <h1 class="page-title">User <span class="highlight">Guide</span></h1>
      <p class="page-subtitle">How the site and the bot work together</p>
    </header>

    <section class="content-block terms-block">
      <h2>How to use the site &amp; bot</h2>
      <ul>
        {guideContent.map((item) => (
          <li>
            <strong>{item.title}</strong>
            <p>{item.description}</p>
          </li>
        ))}
      </ul>
    </section>

    <SwipeNav pages={pages} current="/guide" />
  </article>
</Base>
