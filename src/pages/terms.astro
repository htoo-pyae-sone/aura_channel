---
import Base from '../layouts/Base.astro';
import SwipeNav from '../components/SwipeNav.astro';

const pages = [
  { href: '/about', label: 'About' },
  { href: '/guide', label: 'Guide' },
  { href: '/terms', label: 'Terms' },
];

const termsContent = [
  {
    title: 'No video hosting',
    description:
      'This site does not store, host, or upload any video or media files. Posters, synopses, and episode lists exist for information only.',
  },
  {
    title: 'Third-party delivery',
    description:
      'Every download link hands you over to an external platform — the Telegram bot, and the storage behind it. We are not responsible for what those external servers host, nor for their compliance or legality.',
  },
  {
    title: 'Original content belongs to its owners',
    description:
      'All anime properties, images, and characters belong to their respective studios and creators. We claim no ownership over any of it.',
  },
  {
    title: 'No redistribution',
    description:
      'Episodes are delivered through the Telegram bot for personal viewing. Re-uploading them to another channel or site, selling them, or redistributing them in any form without written permission is not allowed. If our videos turn up anywhere without permission, send us the link at anixsubs@gmail.com — we will act on it, starting with a takedown request to whoever is hosting the copy.',
  },
  {
    title: 'DMCA & contact',
    description:
      'If you hold a copyright and want a link removed, or you have a concern about a translation, write to anixsubs@gmail.com.',
  },
  {
    title: 'Anonymous analytics',
    description:
      'We use Vercel Analytics to count visits and measure page speed. It sets no cookies and stores nothing on your device, and it does not follow you between visits — the figures are reported in aggregate, not tied to any one reader.',
  },
];
---

<Base title="Terms & Policies — aniXsubs">
  <article class="page-container">
    <a class="back-link" href="/" onclick="if(history.length>1){history.back();return false;}">&larr; Back</a>
    <header class="page-header">
      <h1 class="page-title">Terms &amp; <span class="highlight">Policies</span></h1>
      <p class="page-subtitle">What this site is, and what it is not</p>
    </header>

    <section class="content-block terms-block">
      <!-- The one sentence that makes this an AGREEMENT rather than a set of
           statements: it names using the site as the act of assent, and the
           clause list below is what the reader is agreeing to. It takes over
           the hairline divider the old h2 used to provide — that heading just
           repeated the h1 sitting directly above it. -->
      <p class="terms-acceptance">By using aniXsubs you agree to these terms.</p>
      <ul>
        {termsContent.map((item) => (
          <li>
            <strong>{item.title}</strong>
            <p>{item.description}</p>
          </li>
        ))}
      </ul>
    </section>

    <SwipeNav pages={pages} current="/terms" />
  </article>
</Base>
