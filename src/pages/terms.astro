---
import Base from '../layouts/Base.astro';
import SwipeNav from '../components/SwipeNav.astro';

const pages = [
  { href: '/about', label: 'About' },
  { href: '/guide', label: 'Guide' },
  { href: '/terms', label: 'Terms' },
];

const termsContent = [
  {
    title: 'No video hosting',
    description:
      'This site does not store, host, or upload video or other media files. Posters, summaries, and episode lists are provided for informational purposes.',
  },
  {
    title: 'Third-party delivery',
    description:
      'Downloads are delivered through external services, including the Telegram bot and the file storage service it uses. aniXsubs does not operate these services or control the files they host.',
  },
  {
    title: 'Original content belongs to its owners',
    description:
      'Anime titles, artwork, characters, and related materials belong to their respective rights holders. aniXsubs does not claim ownership of them.',
  },
  {
    title: 'No redistribution',
    description:
      'Episodes are provided through the Telegram bot for personal viewing. Do not re-upload, sell, or redistribute them on another channel or site without written permission. If you find an unauthorized copy, email the link to anixsubs@gmail.com. We may request its removal from the service hosting it.',
  },
  {
    title: 'Copyright and contact',
    description:
      'If you are a copyright holder requesting the removal of a link, or if you have a concern about a translation, please contact us at anixsubs@gmail.com.',
  },
  {
    title: 'Anonymous analytics',
    description:
      'We use Vercel Analytics to measure visits and page performance. It does not use cookies or store data on your device. Reports are aggregated and are not linked to individual readers.',
  },
];
---

<Base title="Terms & Policies — aniXsubs">
  <article class="page-container">
    <a class="back-link" href="/" onclick="if(history.length>1){history.back();return false;}">&larr; Back</a>
    <header class="page-header">
      <h1 class="page-title">Terms &amp; <span class="highlight">Policies</span></h1>
      <p class="page-subtitle">What this site is and is not</p>
    </header>

    <section class="content-block terms-block">
      <!-- The one sentence that makes this an AGREEMENT rather than a set of
           statements: it names using the site as the act of assent, and the
           clause list below is what the reader is agreeing to. It takes over
           the hairline divider the old h2 used to provide — that heading just
           repeated the h1 sitting directly above it. -->
      <p class="terms-acceptance">By using aniXsubs you agree to these terms.</p>
      <ul>
        {termsContent.map((item) => (
          <li>
            <strong>{item.title}</strong>
            <p>{item.description}</p>
          </li>
        ))}
      </ul>
    </section>

    <SwipeNav pages={pages} current="/terms" />
  </article>
</Base>
