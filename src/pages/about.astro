---
import Base from '../layouts/Base.astro';
import SwipeNav from '../components/SwipeNav.astro';

const pages = [
  { href: '/about', label: 'About' },
  { href: '/guide', label: 'Guide' },
  { href: '/terms', label: 'Terms' },
];

const aboutContent = [
  {
    title: 'What is aniXsubs?',
    description:
      'aniXsubs is an independent project that provides anime with Burmese subtitles. Each subtitle begins as an AI-generated draft. We then review the timing, spelling, and natural flow of the dialogue by hand before encoding and releasing the episode.',
  },
  {
    title: 'A catalog, not a host',
    description:
      'This site does not store video files. It brings together posters, episode lists, and links to the Telegram bot, where episodes are delivered. Downloads are provided through the bot.',
  },
  {
    title: 'How releases work',
    description:
      'Titles are selected by hand, so releases do not follow a fixed schedule. aniXsubs is a fan project maintained in our spare time, not a simulcast service. We focus on carefully reviewed subtitles and clean encodes for the episodes we release.',
  },
  {
    title: 'A small request',
    description:
      'Translation mistakes and delays can happen. If you notice an issue or have a suggestion, email us at anixsubs@gmail.com. Viewer feedback helps us improve future episodes.',
  },
];
---

<Base title="About Us — aniXsubs">
  <article class="page-container">
    <a class="back-link" href="/" onclick="if(history.length>1){history.back();return false;}">&larr; Back</a>
    <header class="page-header">
      <h1 class="page-title">aniX<span class="highlight">subs</span></h1>
      <p class="page-subtitle">Independent anime subtitles in Burmese</p>
    </header>

    <div class="content-blocks">
      {aboutContent.map((item) => (
        <section class="content-block glass-card">
          <h2>{item.title}</h2>
          <p>{item.description}</p>
        </section>
      ))}
    </div>

    <SwipeNav pages={pages} current="/about" />
  </article>
</Base>
