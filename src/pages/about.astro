---
import Base from '../layouts/Base.astro';
import SwipeNav from '../components/SwipeNav.astro';

const pages = [
  { href: '/about', label: 'About' },
  { href: '/guide', label: 'Guide' },
  { href: '/terms', label: 'Terms' },
];

const aboutContent = [
  {
    title: 'What is aniXsubs?',
    description:
      'aniXsubs is an independent project making anime with Burmese subtitles. Subtitles start as an AI-generated draft and are then checked by hand — timing, spelling, and whether the dialogue sounds like something a person would actually say — before each episode is encoded and released.',
  },
  {
    title: 'A catalog, not a host',
    description:
      'This site holds no video files. It is an index: posters, episode lists, and links that hand you over to the Telegram bot, which is where the files actually live. Every download runs through the bot.',
  },
  {
    title: 'How releases work',
    description:
      'Titles are picked by hand, so there is no fixed schedule — this is fan work done in spare hours, not a simulcast operation. What is promised instead: careful subtitles and clean encodes for every episode that ships.',
  },
  {
    title: 'A small request',
    description:
      'Mistranslations and late uploads still happen. Feedback is welcome at anixsubs@gmail.com — corrections from viewers genuinely make the next episode better.',
  },
];
---

<Base title="About Us — aniXsubs">
  <article class="page-container">
    <a class="back-link" href="/" onclick="if(history.length>1){history.back();return false;}">&larr; Back</a>
    <header class="page-header">
      <h1 class="page-title">aniX<span class="highlight">subs</span></h1>
      <p class="page-subtitle">Independent Anime Subtitles, Burmese</p>
    </header>

    <div class="content-blocks">
      {aboutContent.map((item) => (
        <section class="content-block glass-card">
          <h2>{item.title}</h2>
          <p>{item.description}</p>
        </section>
      ))}
    </div>

    <SwipeNav pages={pages} current="/about" />
  </article>
</Base>
